// Strict TypeScript for tests that need both Worker and DOM types: unit tests that import a Worker module and a DOM
// module, and browser tests that import a Worker module (server/security.ts, server/game.ts, upload helpers).
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["@cloudflare/workers-types", "node"],
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "files": [
    "types/lib-guards.ts",
    "types/site.ts",
    "site.config.js",
    "types/dom.ts",
    "tests/arena-client.test.ts",
    "tests/atlas.test.ts",
    "tests/cosmetics.test.ts",
    "tests/spritify.test.ts",
    "tests/e2e-local.ts",
    "tests/smoke.ts",
    "tests/ui.ts",
    "tests/arena-browser.ts"
  ]
}
