# Static responses only; /api/* and /auth/* set their own headers in server/worker.js.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Pages with sign-in and mod actions can't be framed by other sites (clickjacking). The overlay stays frameable for OBS.
# The pages now pass through the Worker, which sets these itself (server/worker.js page()); kept for asset-only routes.
/
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
/admin/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
/start/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# The OBS overlay stays out of search results. The test site's pages and robots.txt say noindex from the Worker (server/worker.js).
/overlay*
  X-Robots-Tag: noindex, nofollow
