{
  "name": "mini-chat",
  "version": "0.12.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "prepare": "node scripts/install-hooks.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json && tsc -p tsconfig.node-dom.json && tsc -p tsconfig.node-all.json && node scripts/port-check.ts --strict-list",
    "port-check": "node scripts/port-check.ts --base origin/main",
    "audit": "bun audit --audit-level=high",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:unit",
    "test": "node tests/smoke.ts",
    "test:unit": "node --import ./tests/register.ts --test \"tests/*.test.ts\"",
    "test:port": "node --test tests/port/port-check.test.ts",
    "test:ui": "node tests/ui.ts && node tests/arena-browser.ts",
    "test:dev-ui": "node tests/dev-ui.ts",
    "test:upload": "node tests/upload-workerd.ts",
    "test:e2e": "node tests/e2e-local.ts",
    "seed:local": "node tests/seed-local.ts",
    "build:characters": "node scripts/build-characters.ts",
    "test:all": "node scripts/test-all.ts",
    "test:live": "node scripts/live-chat-e2e.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "cf": "1.0.0-beta.9",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.0"
  },
  "trustedDependencies": [
    "workerd"
  ]
}
