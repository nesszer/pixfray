// Strict TypeScript. Every new or ported .ts file is listed here, one entry per file; scripts/port-check.ts fails a
// branch that changes a .ts file missing from this list.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types", "node"],
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "files": [
    "types/lib-guards.ts",
    "types/site.ts",
    "site.config.js",
    "scripts/lib/port.ts",
    "scripts/port-check.ts",
    "scripts/port-rename.ts",
    "scripts/lib/served.ts",
    "server/env.ts",
    "server/model.ts",
    "server/upgrades.ts",
    "server/uploads.ts",
    "server/cosmetics.ts",
    "server/botcommands.ts",
    "server/dedupe.ts",
    "server/hosts.ts",
    "server/ranklog.ts",
    "server/ratelimit.ts",
    "server/security.ts",
    "server/pets.ts",
    "server/sprites.ts",
    "server/game.ts",
    "server/streamelements.ts",
    "server/auth.ts",
    "server/channels.ts",
    "server/eventsub.ts",
    "server/backups.ts",
    "server/accounts.ts",
    "server/developer.ts"
  ]
}
