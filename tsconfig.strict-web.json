// Strict TypeScript for browser code (src/ and types/dom.ts): DOM types, no Worker or Node types.
// Every ported browser .ts file is listed here, one entry per file; Worker, script and shared files go in
// tsconfig.strict.json. scripts/port-check.ts fails a branch that changes a .ts file missing from both lists.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "files": [
    "types/lib-guards.ts",
    "types/site.ts",
    "site.config.js",
    "types/dom.ts",
    "src/channel-param.ts",
    "src/character-groups.ts",
    "src/setup.ts",
    "src/scrub.ts",
    "src/intro/back.ts",
    "src/intro/sound.ts",
    "src/ui.ts",
    "src/start.ts",
    "src/sprite-maker.ts",
    "src/spritify.ts",
    "src/intro/bevel.ts",
    "src/intro/voxels.ts",
    "src/intro/world.ts",
    "src/fighter3d.ts",
    "src/voxthumb.ts",
    "src/intro/main.ts",
    "src/served/hats.ts",
    "src/served/atlas.ts",
    "src/served/chat.ts",
    "src/served/arena-client.ts",
    "src/served/pets.ts",
    "src/served/cosmetics.ts",
    "src/served/upload.ts",
    "src/served/overlay.ts",
    "src/dashboard.ts",
    "src/admin.ts",
    "src/dev.ts"
  ]
}
