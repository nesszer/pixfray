// Node code with Workers and Node types, no DOM: the build configs, the scripts and tests that need no DOM or Buffer
// methods, and every unit test that imports only Worker and shared modules. A new script or test lands here; the
// files that need DOM types are excluded and listed in tsconfig.node-dom.json or tsconfig.node-all.json.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "lib": ["esnext"], "types": ["@cloudflare/workers-types", "node"] },
  "include": ["*.ts", "scripts/**/*.ts", "tests/**/*.ts", "types/lib-guards.ts", "types/site.ts", "site.config.js"],
  "exclude": [
    "tests/browser-parse.test.ts",
    "tests/overlay.test.ts",
    "tests/served.test.ts",
    "tests/dev-ui.ts",
    "scripts/og-image.ts",
    "scripts/lib/zip-read.ts",
    "scripts/lib/png-io.ts",
    "scripts/build-characters.ts",
    "scripts/live-chat-e2e.ts",
    "tests/arena-client.test.ts",
    "tests/atlas.test.ts",
    "tests/cosmetics.test.ts",
    "tests/spritify.test.ts",
    "tests/e2e-local.ts",
    "tests/smoke.ts",
    "tests/ui.ts",
    "tests/arena-browser.ts"
  ]
}
