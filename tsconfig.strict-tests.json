// Strict TypeScript for Node code that needs DOM types but imports no Worker module: unit tests of a DOM module
// (src/served/overlay.ts), and Playwright tests and scripts whose page callbacks run in the browser. Node-only scripts
// that use Buffer's methods (the character build) live here too: the Worker types in tsconfig.strict.json hide them.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node"],
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "files": [
    "types/lib-guards.ts",
    "types/site.ts",
    "site.config.js",
    "types/dom.ts",
    "tests/browser-parse.test.ts",
    "tests/overlay.test.ts",
    "tests/served.test.ts",
    "tests/dev-ui.ts",
    "scripts/og-image.ts",
    "scripts/lib/zip-read.ts",
    "scripts/lib/png-io.ts",
    "scripts/build-characters.ts",
    "scripts/live-chat-e2e.ts"
  ]
}
